APP_ENV=production
APP_DEBUG=false
APP_KEY=

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Cache & Session Configuration
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# Session Security
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Security Settings
CSP_ENABLED=true
CSP_NONCE_ENABLED=true
APP_BUGSNAG=false
