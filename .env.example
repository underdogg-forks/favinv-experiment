APP_ENV=production
APP_DEBUG=false
APP_KEY=

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Cache & Session Configuration
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# Session Security
# Note: Set to false for local development without HTTPS
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

# Password Hashing
# Options: bcrypt, argon, argon2id (argon2id recommended for new installations)
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Security Settings
CSP_ENABLED=true
CSP_NONCE_ENABLED=true
APP_BUGSNAG=false

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
REGISTRATION_MAX_ATTEMPTS=3
REGISTRATION_DECAY_MINUTES=60

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true
